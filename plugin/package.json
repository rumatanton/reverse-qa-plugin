{
  "name": "reverse-qa-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scripts, hooks and tests for the reverse-qa Claude Code plugin.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/{unit,hooks,contract,integration}/**/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\" \"tests/hooks/**/*.test.mjs\"",
    "test:report": "node -e \"require(\\\"fs\\\").mkdirSync(\\\"test-results\\\",{recursive:true})\" && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/junit.xml \"tests/{unit,hooks,contract,integration}/**/*.test.mjs\"",
    "test:behavior": "node -e \"require(\\\"fs\\\").mkdirSync(\\\"test-results\\\",{recursive:true})\" && node --test --test-timeout=7000000 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/behavior-junit.xml tests/behavior/agents.test.mjs",
    "test:e2e": "node --test --test-timeout=1200000 \"tests/e2e/**/*.test.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
