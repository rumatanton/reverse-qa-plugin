{
  "name": "rqa-framework-__TARGET__",
  "private": true,
  "type": "module",
  "description": "Playwright + TypeScript test framework for __TARGET__, generated by reverse-qa (plugin/templates/framework).",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:p1": "playwright test --project=chromium --grep @p1",
    "test:browsers": "playwright test --project=firefox --project=webkit --project=mobile",
    "test:visual": "playwright test --project=visual",
    "test:ui": "playwright test --ui",
    "test:watch": "playwright test --project=chromium --headed --workers=1",
    "selftest": "playwright test --project=selftest --project=unit",
    "flake-gate": "playwright test --project=chromium --repeat-each=5 --only-changed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@xray-app/playwright-junit-reporter": "0.16.0"
  }
}
